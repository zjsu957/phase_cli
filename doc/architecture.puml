@startuml
title SVG Editor — 第五版依赖方向与交付验证
skinparam componentStyle rectangle
component "main.ts\n对象组装" as Main
package "cli/" {
  component "Repl\n终端与流 IO" as Repl
  component "Tokenizer / CommandToken / Arguments\nCommandRouter / CommandDefinition" as Cli
}
package "application/" {
  component "Editor / CommandHistory" as App
  component "commands/\nEditCommand / SnapshotCommand\n具体编辑命令" as Commands
  component "DocumentPresenter\nShapeVisitor 实现" as Presenter
  interface "ports/DocumentStore" as Store
  component "LoadedDocument" as Loaded
}
package "domain/" {
  component "SvgDocument\nShape / GeometryShape\nRect / Circle / Ellipse / Line / Text / Group" as Model
  component "ShapeFactory / ShapeDefinition" as Factory
  component "ShapeVisitor 接口" as Visitor
  component "EditorError / NumericValue / XmlValue" as Values
}
package "infrastructure/" {
  component "files/NodeDocumentStore\n临时文件 + 原子替换" as Files
  component "svg/SvgParser\nsvg/SvgSerializer" as Svg
  component "@xmldom/xmldom" as Xml
}
Main --> Repl
Main --> App
Main --> Files
Repl --> Cli
Cli --> App
Cli --> Commands
Cli --> Values
App --> Commands
App --> Presenter
App --> Model
App --> Factory
App --> Store
App --> Loaded
Files ..|> Store
Files --> Svg
Files --> Loaded
Svg --> Factory
Svg --> Model
Svg --> Loaded
Svg --> Xml
Svg ..|> Visitor
Commands --> Factory
Commands --> Model
Presenter --> Model
Presenter ..|> Visitor
Factory --> Model
Model --> Visitor
Model --> Values
package "开发检查（不进入运行时）" {
  component "scripts/ArchitectureCheck\nAST 依赖、封装、环检查" as Guard
  component "@babel/parser\n仅开发依赖" as Babel
  component "tests/\nCliProcess / HistorySequence\nArchitecture 与既有测试" as Tests
  component "scripts/RuntimeSmokeCheck\nNode 内建类型擦除\n无需开发依赖" as Smoke
}
Guard --> Babel
Tests ..> Guard : 验证规则与违规样例
Tests ..> Main : 真实子进程验收
Smoke ..> Main : 编译后的 dist/main.js
note bottom of Guard
  扫描 src 中 43 个生产文件，
  检查文档声明的依赖方向；
  不作为产品运行时组件。
end note
@enduml
