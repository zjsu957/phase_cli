@startuml
title SVG Editor — 第三版依赖方向
skinparam componentStyle rectangle
component "main.ts\n对象组装" as Main
package "cli/" {
  component "Repl\n终端与流 IO" as Repl
  component "Tokenizer / CommandToken / Arguments\nCommandRouter / CommandDefinition" as Cli
}
package "application/" {
  component "Editor / CommandHistory" as App
  component "commands/\nEditCommand / SnapshotCommand\n具体编辑命令" as Commands
  component "DocumentPresenter\nShapeVisitor 实现" as Presenter
  interface "ports/DocumentStore" as Store
  component "LoadedDocument" as Loaded
}
package "domain/" {
  component "SvgDocument\nShape / GeometryShape\nRect / Circle / Ellipse / Line / Text / Group" as Model
  component "ShapeFactory / ShapeDefinition" as Factory
  component "ShapeVisitor 接口" as Visitor
  component "EditorError / NumericValue / XmlValue" as Values
}
package "infrastructure/" {
  component "files/NodeDocumentStore\n临时文件 + 原子替换" as Files
  component "svg/SvgParser\nsvg/SvgSerializer" as Svg
  component "@xmldom/xmldom" as Xml
}
Main --> Repl
Main --> App
Main --> Files
Repl --> Cli
Cli --> App
Cli --> Commands
Cli --> Values
App --> Commands
App --> Presenter
App --> Model
App --> Factory
App --> Store
App --> Loaded
Files ..|> Store
Files --> Svg
Files --> Loaded
Svg --> Factory
Svg --> Model
Svg --> Loaded
Svg --> Xml
Svg ..|> Visitor
Commands --> Factory
Commands --> Model
Presenter --> Model
Presenter ..|> Visitor
Factory --> Model
Model --> Visitor
Model --> Values
@enduml
