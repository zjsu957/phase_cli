{
  "name": "svg-editor",
  "version": "0.5.0",
  "description": "Lab1 Phase 1: object-oriented SVG CLI editor",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "cli": "tsx src/main.ts",
    "start": "node dist/main.js",
    "smoke:dist": "node scripts/RuntimeSmokeCheck.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "test:acceptance": "vitest run tests/CliProcess.test.ts tests/HistorySequence.test.ts tests/Architecture.test.ts",
    "check": "npm run typecheck && npm run check:architecture && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
